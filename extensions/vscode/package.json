{
  "name": "reposcope",
  "displayName": "RepoScope",
  "description": "The code graph, in your editor. Blast radius, callers, and a live architecture map - from the same index the RepoScope canvas draws.",
  "version": "2.0.1",
  "publisher": "adityapatel5912",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityapatel5912/RepoScope.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Visualization", "Other"],
  "keywords": ["code graph", "architecture", "blast radius", "mcp", "dependencies"],
  "activationEvents": [
    "onStartupFinished",
    "onView:reposcope.graph",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:go",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reposcope",
          "title": "RepoScope",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reposcope": [
        {
          "id": "reposcope.graph",
          "name": "Architecture",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "reposcope.refresh",
        "title": "RepoScope: Refresh the index",
        "category": "RepoScope"
      },
      {
        "command": "reposcope.openCanvas",
        "title": "RepoScope: Open the architecture canvas",
        "category": "RepoScope"
      },
      {
        "command": "reposcope.showGraph",
        "title": "RepoScope: Show the architecture map",
        "category": "RepoScope"
      },
      {
        "command": "reposcope.showCallers",
        "title": "RepoScope: Show callers",
        "category": "RepoScope"
      },
      {
        "command": "reposcope.showBlastRadius",
        "title": "RepoScope: Show blast radius",
        "category": "RepoScope"
      },
      {
        "command": "reposcope.focusNode",
        "title": "RepoScope: Focus this node in the canvas",
        "category": "RepoScope"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "reposcope.focusNode",
          "group": "navigation@10",
          "when": "resourceScheme == file"
        }
      ],
      "commandPalette": [
        {
          "command": "reposcope.focusNode",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "RepoScope",
      "properties": {
        "reposcope.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "The RepoScope backend. Run `reposcope run .` to start one."
        },
        "reposcope.canvasUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4100",
          "description": "The RepoScope web canvas. `reposcope run .` serves it on port 4100."
        },
        "reposcope.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the blast-radius indicator in the status bar."
        },
        "reposcope.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the caller count above exported symbols."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
