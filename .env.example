# ── LLM keys — comma-separate for automatic rotation on rate limits ─────────
# Chain: OpenRouter (primary) → Groq (secondary) → NVIDIA NIM (fallback)

# OpenRouter (primary, free models available)
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2
Base_URL_OPENROUTER=https://openrouter.ai/api/v1
Models_OPENROUTER=google/gemma-3-27b-it:free,qwen/qwen3.8-27b:free

# Groq (secondary)
GROQ_API_KEYS=gsk_key1,gsk_key2
Base_URL_GROQ=https://api.groq.com/openai/v1
Models_GROQ=llama-3.3-70b-versatile

# NVIDIA NIM (fallback)
NVIDIA_API_KEYS=nvapi_key1,nvapi_key2
Base_URL_NVIDIA=https://integrate.api.nvidia.com/v1
Models_NVIDIA=meta/llama-3.3-70b-instruct

# GitHub — raises API rate limits; comma-separate for rotation
GITHUB_TOKENS=ghp_token1,ghp_token2

# MCP codebase-memory server binary (fallback graph builder)
CODEBASE_MEMORY_PATH=codebase-memory-mcp

# ── Legacy single-key variables (still supported as fallbacks) ──────────────
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# GITHUB_PAT=
